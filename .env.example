# .env.example — Acme Services ops scripts (sanitized demo)
# Copy to .env, fill in real values, chmod 600 .env
#
# NOTE: in this demo copy, several of these are still inline placeholders in
# the code (search for "YOUR_"). The ones marked [env] are already read from
# the environment by at least one script.

# ── Google Gemini ──────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key            # [env] clockshark_audit/*; inline as YOUR_GEMINI_API_KEY elsewhere
GEMINI_MODEL=gemini-2.5-flash                 # pin explicit versions; avoid "-latest" aliases

# ── gog (Google Workspace CLI) ─────────────────────────────────
GOG_KEYRING_BACKEND=file                      # avoids interactive passphrase prompts
GOG_KEYRING_PASSWORD=your-keyring-password    # [env] inline as YOUR_GOG_KEYRING_PASSWORD in most scripts
GOG_BIN=/usr/local/bin/gog

# ── Accounts ───────────────────────────────────────────────────
BOT_ACCOUNT=bot@example.com                   # inbox that receives alerts/exports and sends reports
OWNER_EMAIL=owner@example.com
MANAGER_EMAILS=manager1@example.com,manager2@example.com

# ── Google Sheets ──────────────────────────────────────────────
KANBAN_SHEET_ID=YOUR_SHEET_ID
GOOGLE_TOKEN_PATH=/home/user/token.json       # OAuth token for the google-api-python-client scripts

# ── ClockShark (Selenium login) ────────────────────────────────
CLOCKSHARK_USER=you@example.com               # [env]
CLOCKSHARK_PASSWORD=your-clockshark-password  # [env]

# ── SMTP (clockshark_audit/process_and_send.py only) ───────────
SMTP_USER=bot@example.com                     # [env]
SMTP_PASS=your-app-password                   # [env]

# ── Notifications ──────────────────────────────────────────────
NTFY_TOPIC=your-ntfy-topic
PI_HOST=192.168.1.50                          # kiosk Pi that plays the alert chime
PI_USER=piuser
PI_BELL_WAV=/home/piuser/coast_bell.wav
